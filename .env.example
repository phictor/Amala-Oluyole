# Runtime identity. APP_ENV must be "staging" for preview infrastructure.
NODE_ENV=
APP_ENV=
PORT=

# Dedicated MySQL connection. Preview must use an isolated staging database.
DATABASE_URL=
DATABASE_ENVIRONMENT_LABEL=

# Authentication and session configuration. Generate unique staging-only values.
JWT_SECRET=
SESSION_ISSUER=
VITE_APP_ID=
OWNER_OPEN_ID=
ALLOWED_ORIGINS=

# Paystack test-mode server secret. Never use a live key for preview.
PAYSTACK_SECRET_KEY=

# Staging OAuth provider and the provider open IDs assigned to seeded test roles.
OAUTH_SERVER_URL=
STAGING_TEST_CUSTOMER_OPEN_ID=
STAGING_TEST_ADMIN_OPEN_ID=
STAGING_TEST_MANAGER_OPEN_ID=
STAGING_TEST_KITCHEN_OPEN_ID=
STAGING_TEST_RIDER_OPEN_ID=

# App-integrity verification services and server-only credentials.
PLAY_INTEGRITY_VERIFIER_URL=
PLAY_INTEGRITY_VERIFIER_TOKEN=
APPLE_APP_ATTEST_VERIFIER_URL=
APPLE_APP_ATTEST_VERIFIER_TOKEN=

# Dedicated staging storage service.
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Dedicated staging email, WhatsApp, and push-notification integrations.
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
EXPO_ACCESS_TOKEN=

# Error monitoring and structured logging. SENTRY_AUTH_TOKEN is build/CI only.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_URL=
SENTRY_ENVIRONMENT=
LOG_LEVEL=

# Optional EAS project UUID override plus the secret CI authentication token.
# The default project UUID is tracked in app.config.ts because it is not a secret.
EAS_PROJECT_ID=
EXPO_TOKEN=

# Public values embedded in the app. The preview API URL must be stable HTTPS.
APP_VARIANT=
# Optional public UUID override for local config evaluation.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_ENVIRONMENT=
EXPO_PUBLIC_DATABASE_ENVIRONMENT_LABEL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_INTEGRITY_ENABLED=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_FEEDBACK_ISSUE_URL=
EXPO_PUBLIC_GIT_COMMIT_SHA=
EXPO_PUBLIC_BUILD_DATE=

# Legacy Manus/Forge services, if still used by the selected deployment.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
